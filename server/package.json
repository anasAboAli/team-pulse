{
  "name": "teampulse-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TeamPulse API — Express + MySQL",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:create": "node db/cli.js create",
    "db:migrate": "node db/cli.js migrate",
    "db:rollback": "node db/cli.js rollback",
    "db:seed": "node db/cli.js seed",
    "db:reset": "node db/cli.js reset",
    "setup": "node db/cli.js create && node db/cli.js reset",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "start:prod": "node db/cli.js create && node db/cli.js bootstrap && node src/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
