# ── الخادم ─────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ── قاعدة البيانات (MySQL / MariaDB) ──
# للاستضافة: استخدم DATABASE_URL بدل DB_* (مثال: mysql://user:pass@host:4000/teampulse?ssl=true)
# DATABASE_URL=
# DB_SSL=true
# DB_SSL_CA=          (شهادة CA عند الحاجة، مثل Aiven)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=teampulse

# ── التوثيق ─────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# ── الملفات ─────────────────────────────
UPLOAD_MAX_MB=10

# ── البيانات التجريبية ──
# SEED_DEMO_DATA=true يعبّئ بيانات تجريبية عند أول تشغيل إنتاجي على قاعدة فارغة (bootstrap)
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@teampulse.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_PASSWORD=Demo@12345
